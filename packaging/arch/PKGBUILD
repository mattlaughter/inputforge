# Maintainer: Matt Laughter <https://github.com/mattlaughter>
pkgname=inputforge
pkgver=0.3.1
pkgrel=1
pkgdesc="Keyboard and mouse remapping, macros, autoclicker and RGB lighting (evdev/uinput, Wayland + X11)"
arch=('x86_64' 'aarch64')
url="https://github.com/mattlaughter/inputforge"
license=('MIT')
depends=('polkit' 'gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'libglvnd' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'systemd-libs')
makedepends=('cargo' 'librsvg')
optdepends=('libratbag: DPI/polling settings for other mice'
            'openrgb: lighting for devices without a built-in driver')
install=inputforge.install
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('268970e3217a8f95719bd7465e8f63b1096d91275e02a022196b77ea395fc567')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Keep build paths out of the binary (panic messages).
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  cargo build --frozen --release
  packaging/render-icons.sh
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/inputforge "$pkgdir/usr/bin/inputforge"
  install -Dm644 packaging/70-inputforge.rules "$pkgdir/usr/lib/udev/rules.d/70-inputforge.rules"
  install -dm755 "$pkgdir/usr/lib/modules-load.d"
  echo uinput > "$pkgdir/usr/lib/modules-load.d/inputforge.conf"
  install -Dm644 packaging/inputforge.desktop "$pkgdir/usr/share/applications/inputforge.desktop"
  install -Dm644 assets/inputforge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/inputforge.svg"
  for s in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "target/icons/inputforge-$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/inputforge.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
